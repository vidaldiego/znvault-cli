{
  "name": "@zincapp/znvault-cli",
  "version": "2.25.0",
  "description": "Official CLI for ZnVault administration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "znvault": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc --sourceMap false",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "pretest": "npm run build",
    "test": "npm run test:unit",
    "test:all": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "ZNVAULT_INTEGRATION=true vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "znvault",
    "vault",
    "secrets",
    "cli",
    "admin"
  ],
  "author": "ZincApp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vidaldiego/znvault-cli"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "conf": "^15.0.2",
    "figlet": "^1.9.4",
    "gradient-string": "^3.0.0",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "ink-ui": "^0.4.0",
    "inquirer": "^13.2.0",
    "open": "^10.1.0",
    "openpgp": "^6.3.0",
    "ora": "^9.0.0",
    "otpauth": "^9.4.1",
    "pg": "^8.17.1",
    "react": "^19.2.3",
    "ws": "^8.19.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/iarna__toml": "^2.0.5",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.8",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
